# MARKET COURTYARD LEDGE (city phase 13's granite ledges in Market Courtyard, off Market by UN Plaza):
# an ollie onto a ledge and a boardslide to its end. (The squeezed city lays the courtyard's ledges
# out again, four to a row and in other places; the start keeps its place beside the ledge.)
park sf
cmd 0 traffic clear
cmd 1 teleport 365.74 261.01 -0.05 295.2
cmd 3 set skater.vel.x -3.620
cmd 3 set skater.vel.y 1.702
hold ollie 102..132
tap grind 144..178 every 4
bot balance
run 600
expect event grindStart{trick=BS Boardslide,line=ledge_362_262} within 143..147
expect event grindEnd{reason=end} within 481..485
expect event gap{id=courtyard_ledge,gap=MARKET COURTYARD LEDGE,points=250} within 481..485
expect event land{quality=clean} within 536..540
expect event comboLanded{name=BS Boardslide + MARKET COURTYARD LEDGE} within 547..551
expect no event bail
expect event goalComplete{id=lunchbreak,name=Lunch Break} within 481..485
