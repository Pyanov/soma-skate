# City goal "Ollie an EV" (kind gap): a boneless over a parked car, across its trunk, landing on
# the road on the far side: the CAR HOP gap (gaps.json kind car) and the goal, once.
park sf
spawn valencia_shops
cmd 0 traffic clear
cmd 0 teleport -62.3 -322 2.31 0
cmd 1 car -51.1 -331.2 356 0
cmd 30 teleport -41.25 -332.19 2.08 265.2
cmd 40 set skater.vel.x -5.98
cmd 40 set skater.vel.y -0.5
hold ollie 42..140
tap up 124
tap up 132
run 400
expect event gap{id=car_hop,points=500} within 280..285
expect event goalComplete{id=carhop,name=Ollie an EV,area=Mission} within 280..285
expect event goalComplete count == 1
expect event comboLanded{name=Boneless + CAR HOP,multiplier=2} within 285..300
expect no event carLand
expect no event bail
