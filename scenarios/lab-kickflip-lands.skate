# Charged ollie, kickflip (J + left) right after the pop: the flip finishes and the combo lands.
park lab
spawn lab_ledge
hold up 0..60
hold ollie 60..90
tap flip+left 96
run 300
expect event trickEnd{trick=Kickflip} within 120..160
expect event comboLanded{name=Kickflip,points=100} within 160..240
expect no event bail
# The last-landing record the view reads (celebrations): filled at touchdown, completed at the bank.
expect skater.lastLand.quality == clean at end
expect skater.lastLand.points == 100 at end
expect skater.lastLand.multiplier == 1 at end
expect skater.lastLand.airTicks > 100 at end
expect no event danger
