# Bump a walker slowly and you swerve off them instead of falling: coming up behind at 1.9 m/s (under
# hitSpeed 3.5), pedHit with bail false, pushed out of them with half your speed left.
park sf
spawn valencia_shops
cmd 0 traffic clear
cmd 1 ped at -65.5 -270 356
cmd 1 teleport -64.4 -274 2.48 355.66
cmd 2 set skater.vel.x -0.1966
cmd 2 set skater.vel.y 2.593
run 600
expect event pedHit{bail=false,speed=1.931} within 498..502
expect skater.hspeed < 1.1 at 502
expect no event bail
expect no event nearMiss
