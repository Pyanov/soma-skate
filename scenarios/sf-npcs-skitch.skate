# sf-skitch-hold with four NPC skaters in the park: the balance noise comes from the world RNG, and
# the NPCs draw from their own stream, so the same taps still hold it 10 s for 1635.
park sf
spawn valencia_shops
cmd 0 traffic clear
cmd 0 seed 7
cmd 0 npc spawn
cmd 0 teleport -62.3 -322 2.31 0
cmd 1 car -51.1 -331.2 356 7
cmd 60 teleport -49.44 -330.22 2.11 355.2
cmd 66 set skater.vel.x -0.58
cmd 66 set skater.vel.y 6.97
hold grab 72..1300
hold right 362..368
hold right 374..380
hold right 386..392
hold right 398..404
hold right 410..416
hold right 422..428
