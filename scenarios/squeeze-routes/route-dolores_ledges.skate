# 'Nothing gated' (docs/squeeze.md): the crew van from the park to dolores_ledges by street (461 m), the driving autopilot on the
# sim's own traffic network (tools/squeeze/routes.ts writes this file). The van must arrive within 25 m of the route's end.
park sf
cmd 0 traffic clear
cmd 1 teleport 57.5 -17.8 -1.1 270
tap use 30
bot drive 57.5,-15.6 46.1,-6.0 17.0,-7.9 -11.7,-11.9 -40.9,-14.0 -69.9,-16.2 -98.9,-18.4 -116.3,-19.7 -140.0,-1.5 -169.0,0.1 -196.9,-2.0 -225.1,-4.1 -236.3,-30.4 -234.1,-58.9 -232.0,-87.6 -229.8,-116.3 -227.6,-144.6 -226.5,-158.7 -226.5,-158.7 from 100 speed 8 corner 4 stop
run 21036
expect skater.pos.x > -251.5 at 21036
expect skater.pos.x < -201.5 at 21036
expect skater.pos.y > -183.7 at 21036
expect skater.pos.y < -133.7 at 21036
