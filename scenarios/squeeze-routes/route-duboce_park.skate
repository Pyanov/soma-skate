# 'Nothing gated' (docs/squeeze.md): the crew van from the park to duboce_park by street (758 m), the driving autopilot on the
# sim's own traffic network (tools/squeeze/routes.ts writes this file). The van must arrive within 25 m of the route's end.
park sf
cmd 0 traffic clear
cmd 1 teleport 57.5 -17.8 -1.1 270
tap use 30
bot drive 57.5,-15.6 46.1,-6.0 17.0,-7.9 -11.7,-11.9 -40.9,-14.0 -69.9,-16.2 -98.9,-18.4 -116.3,-19.7 -140.0,-1.5 -140.0,27.3 -140.9,55.8 -151.1,83.6 -153.6,113.0 -155.7,141.2 -161.6,161.8 -175.6,187.8 -193.0,212.0 -217.3,216.6 -235.9,213.5 -250.0,201.1 -276.4,186.8 -296.5,185.3 -316.7,183.8 -337.2,182.3 -358.1,180.3 -377.8,177.1 -397.6,174.5 -403.7,174.0 from 100 speed 8 corner 4 stop
run 29936
expect skater.pos.x > -428.7 at 29936
expect skater.pos.x < -378.7 at 29936
expect skater.pos.y > 149.0 at 29936
expect skater.pos.y < 199.0 at 29936
